# Cloudflare response headers. GitHub Pages ignores this file.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000

# Pages: always check for the latest deploy, so changes show up immediately
/
  Cache-Control: public, max-age=0, must-revalidate
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# style.css and site.js are loaded with ?v=<content hash>, so a new version always has a new address
/style.css
  Cache-Control: public, max-age=31536000, immutable
/site.js
  Cache-Control: public, max-age=31536000, immutable

# Fonts and libraries never change
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# Images and videos: one week, refreshed in the background (they keep their names when replaced)
/assets/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Files for search engines and AI agents
/robots.txt
  Cache-Control: public, max-age=3600
/sitemap.xml
  Cache-Control: public, max-age=3600
/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
/agents.md
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=3600
